<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Timeline</title>

<link rel="stylesheet"
href="/style.css">

</head>

<body>

<h1>Timeline</h1>

<% posts.forEach(post => { %>

<div class="post">

<h2><%= post.name %></h2>

<p class="date">
<%= post.createdAt %>
</p>

<p><%= post.message %></p>

</div>

<% }) %>

</body>

</html>