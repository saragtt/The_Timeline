<!DOCTYPE html>

<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport"
      content="width=device-width, initial-scale=1.0">

    <title>Timeline</title>

    <link rel="stylesheet"
      href="/style.css">
  </head>

  <body>

    <h1>Timeline</h1>

    <div class="post">
      <h2>Create a new Post</h2>

      <% if (locals.postError) { %>
        <h3 style="color: red; text-align: center;">
          <%= postError %>
        </h3>
      <% } %>

      <form action="/add-post" method="POST">

        <input
          type="text"
          name="name"
          placeholder="Your name">

        <textarea
          name="message"
          placeholder="Type something (at least 25 characters)..."
          rows="4"></textarea>

        <button type="submit">
          Publish
        </button>

      </form>
    </div>

    <% posts.forEach(post => { %>

      <div class="post">

        <h3><%= post.name %></h3>

        <p class="date">
          Published:
          <%= post.createdAt ? post.createdAt.toLocaleString('it-IT') : '' %>
        </p>

        <p><%= post.post %></p>

        <% comments.forEach(comment => { %>

          <% if (comment.postId.toString() === post._id.toString()) { %>

            <div class="comment">

              <strong><%= comment.name %></strong>

              <p class="date">
                Published:
                <%= comment.createdAt ? comment.createdAt.toLocaleString('it-IT') : '' %>
              </p>

              <p><%= comment.comment %></p>

            </div>

          <% } %>

        <% }) %>

        <div class="actions">

          <a href="/edit-post/<%= post._id %>"
            class="action-button">
            Edit
          </a>

          <form action="/delete-post/<%= post._id %>"
            method="POST">

            <button
              type="submit"
              class="action-button">
              Delete
            </button>

          </form>

        </div>

        <form action="/add-comment/<%= post._id %>"
          method="POST">

          <input
            type="text"
            name="name"
            placeholder="Your name">

          <textarea
            name="comment"
            rows="3"
            placeholder="Write a comment..."></textarea>

          <% if (locals.commentError) { %>
            <h5 style="color: red;">
              <%= commentError %>
            </h5>
          <% } %>

          <button type="submit">
            Post Comment
          </button>

        </form>

      </div>

    <% }) %>

  </body>

</html>